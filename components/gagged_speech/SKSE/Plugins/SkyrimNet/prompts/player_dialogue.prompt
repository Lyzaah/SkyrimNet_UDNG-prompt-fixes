{#
  Overlay of stock player_dialogue.prompt.

  Voice/typed lines only hit this file if dialogue.enableTransformation is ON.
  When OFF, Chatterbox reads the STT/typed text raw — a gag cannot stop that.

  Gagged/hooded: no spoken line. Ungagged: output the player's words unchanged
  (do not "rewrite in her voice" — they already said it).
#}
{% set _speaker_gagged = false %}
{% set _speaker_gag = false %}
{% set _speaker_hood = false %}
{% set _speaker_hoodOnly = false %}
{% set _speaker_layered = false %}
{% set _speaker_gagName = "" %}
{% set _speaker_gagNameKnown = false %}
{% set _speaker_blind = false %}
{% set _speaker_gagElapsed = -1 %}
{% if exists("npc") and existsIn(npc, "UUID") %}
{% set _speaker_gag = worn_has_keyword(npc.UUID, "zad_DeviousGag") or worn_has_keyword(npc.UUID, "zbfWornGag") %}
{% set _speaker_hood = worn_has_keyword(npc.UUID, "zad_DeviousHood") %}
{% set _speaker_gagged = _speaker_gag or _speaker_hood %}
{% set _speaker_hoodOnly = _speaker_hood and not _speaker_gag %}
{% set _speaker_layered = _speaker_gag and _speaker_hood %}
{% set _rawGagName = vrtedd_gag_name(npc.UUID) %}
{% set _speaker_gagNameKnown = isString(_rawGagName) and _rawGagName != "" %}
{% if _speaker_gagNameKnown %}{% set _speaker_gagName = lower(_rawGagName) %}{% endif %}
{% set _rawBlind = vrtedd_blind(npc.UUID) %}
{% set _speaker_blind = isString(_rawBlind) and _rawBlind != "" %}
{% if _speaker_gag %}
{% set _gagLockEvents = get_recent_events(get_event_history_count(npc.UUID), npc.UUID) %}
{% set _gagLockTime = 0 %}
{% for event in _gagLockEvents %}
{% if event.type == "mod_event" and event.data.event_name == "SkyrimNetDDUDNG_Event" and contains(event.data.str_arg, "locked") and contains(event.data.str_arg, "Gag") and not contains(event.data.str_arg, "unlocked") %}
{% if event.gameTime > _gagLockTime %}{% set _gagLockTime = event.gameTime %}{% endif %}
{% endif %}
{% endfor %}
{% if _gagLockTime > 0 %}{% set _speaker_gagElapsed = gameTimeNumeric - _gagLockTime %}{% endif %}
{% endif %}
{% endif %}
[ system ]
You are {{ decnpc(npc.UUID).name }}, a {{ decnpc(npc.UUID).gender }} {{ decnpc(npc.UUID).race }} in Skyrim.
{% if _speaker_gagged %}
{{ decnpc(npc.UUID).name }} is gagged and/or hooded. The mouth cannot form words. This is body language, not speech.
{% endif %}

{% if triggeringEvent and triggeringEvent.type %}
You are reacting to: {{ format_event(triggeringEvent, "recent_events") }}
{% endif %}

{{ render_subcomponent("system_head", "transform") }}
[ end system ]

{{ render_template("components\\event_history") }}


[ user ]
{% if _speaker_gagged %}
## Mouth is blocked — no spoken line
{% if length(promptForDialogue) > 0 %}
{{ decnpc(npc.UUID).name }} is *trying* to say: "{{ promptForDialogue }}"
Those words do not come out. Do not write them. Do not paraphrase them into readable speech, and do not put a listener-decodable version inside narration (no pointing that spells the request, no mouthed syllables a lip-reader could use). Keep the emotion of the attempt — anger, plea, fear, impatience — and the humiliation of it failing in front of people. She is helpless. The gag is winning. The room is watching.
{% if _speaker_hoodOnly %}
Her mouth isn't gagged, but the hood traps her voice inside the fabric just the same — muffled by cloth, not by a gag filling her mouth. Keep it dry: no drool/wetness language, this is fabric-muffled, not spit-slick.
{% else if _speaker_layered %}
Gag and hood together — the worst of both. Whatever sound or drool escapes the gag has nowhere to go but the inside of the mask: it pools, it echoes, her own breath comes back at her hot and close. This is the maximum-helplessness tier — play it as such.
{% else if _speaker_gag %}
{% if _speaker_gagNameKnown and contains(_speaker_gagName, "ring") %}
A ring gag — her mouth is forced open around it, nothing blocks the sound so much as shapes it into open, drooling vowels.
{% else if _speaker_gagNameKnown and contains(_speaker_gagName, "ball") %}
A ball gag — the ball fills her mouth, sound comes out low and thick around it.
{% else if _speaker_gagNameKnown and contains(_speaker_gagName, "muzzle") %}
A muzzle — sealed hard over her whole lower face, barely any sound gets out at all, not even a clean syllable-shape.
{% else if _speaker_gagNameKnown and contains(_speaker_gagName, "panel") %}
A panel gag — strapped flat over her mouth, voice comes out compressed and close, almost intelligible and never quite.
{% else if _speaker_gagNameKnown and (contains(_speaker_gagName, "pussy") or contains(_speaker_gagName, "fleshlight")) %}
Not a gag in the ordinary sense — a molded insert that uses her mouth like the other hole it's shaped after. What comes out is thick, humiliated, and has nothing to do with words.
{% endif %}
{% endif %}
{% if _speaker_gagElapsed >= 0 %}
{% if _speaker_gagElapsed > 3600 %}
It has been locked a while now — jaw aching, drool soaked all the way through whatever it's pressed against.
{% else if _speaker_gagElapsed > 1800 %}
It has settled in — she has stopped fighting the initial shock of it, just working around it now.
{% else %}
It was locked on recently — everything about it still feels fresh and wrong.
{% endif %}
{% endif %}
{% if _speaker_blind %}
She can't see the room reacting to this either — no eye contact to fall back on, just sound and touch and the guess of who's near.
{% endif %}
{% else if triggeringEvent and triggeringEvent.type %}
React to this {{ triggeringEvent.type }} event with the body only.
{% if triggeringEvent.data %}
Event: {{ format_event(triggeringEvent, "recent_events") }}
{% endif %}
{% else %}
A brief gagged beat. Body only.
{% endif %}
{% if is_narration_enabled() %}
Output ONLY asterisk-wrapped narration of {{ decnpc(npc.UUID).name }} — strain, drool, glare, a muffled sound *described inside the asterisks*, the helpless little failure of a girl who cannot make herself heard. Nothing outside asterisks. The voice engine reads unwrapped text as speech; leave it empty on purpose. Never repeat the same physical beat twice. Vary the body: jaw, strap, spit, eyes, stomp, throat, chin, hood, the way people are looking at her.
{% else %}
Output one short muffled sound. No words. Narration is off, so this is all the mouth can do.
{% endif %}

{{ render_subcomponent("user_final_instructions", "transform") }}
{% else %}
{% if triggeringEvent and triggeringEvent.type %}
React audibly to this {{ triggeringEvent.type }} event{% if is_narration_enabled() %} with dialogue and/or brief action{% endif %}.
{% if triggeringEvent.data %}
Event: {{ format_event(triggeringEvent, "recent_events") }}
{% endif %}

{% elif length(promptForDialogue) > 0 %}
## Speak this line unchanged
"{{ promptForDialogue }}"
Output that line exactly. Same words, same meaning. Do not rewrite, polish, or expand it.

{% else %}
Say something aloud—a brief spoken reaction to the moment. This is dialogue, not internal thought.
If someone is nearby, you might address them. Otherwise, speak to yourself or comment on your surroundings.
Keep it to 1-2 sentences.

{% endif %}

{{ render_subcomponent("user_final_instructions", "transform") }}
Respond in character now.
{% endif %}
[ end user ]
